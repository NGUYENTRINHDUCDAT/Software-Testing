<tr><td rowspan="1" colspan="3" data-tags="">Blog tag</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>https://demo.nopcommerce.com/<datalist><option>https://demo.nopcommerce.com/</option></datalist></td><td></td></tr>
<tr><td>click</td><td>link=Blog<datalist><option>link=Blog</option><option>xpath=//a[contains(text(),'Blog')]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='News'])[2]/following::a[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Search'])[2]/following::a[2]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Recently viewed products'])[1]/preceding::a[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Compare products list'])[1]/preceding::a[2]</option><option>xpath=//*/text()[normalize-space(.)='Blog']/parent::*</option><option>xpath=//a[contains(@href, '/blog')]</option><option>xpath=//nav/div[2]/div/div[3]/a</option></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>xpath=//main[@id='main']/div/section/div/div[2]/div/article/header<datalist><option>xpath=//main[@id='main']/div/section/div/div[2]/div/article/header</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Blog'])[1]/following::header[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='RSS'])[1]/following::header[1]</option><option>xpath=//article/header</option><option>css=header.post-head</option></datalist></td><td></td></tr>
<tr><td>click</td><td>link=e-commerce<datalist><option>link=e-commerce</option><option>xpath=//a[contains(text(),'e-commerce')]</option><option>xpath=//main[@id='main']/div/aside/section[2]/div/ul/li[2]/a</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='blog'])[1]/following::a[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Popular blog tags'])[1]/following::a[2]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='money'])[1]/preceding::a[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='nopCommerce'])[1]/preceding::a[2]</option><option>xpath=//*/text()[normalize-space(.)='e-commerce']/parent::*</option><option>xpath=//a[contains(@href, '/blog/tag/e-commerce')]</option><option>xpath=//section[2]/div/ul/li[2]/a</option></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>xpath=//main[@id='main']/div/section/div/div[2]/div/article/header<datalist><option>xpath=//main[@id='main']/div/section/div/div[2]/div/article/header</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)=concat('Blog posts tagged with ', "'", 'e-commerce', "'", '')])[1]/following::header[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='RSS'])[1]/following::header[1]</option><option>xpath=//article/header</option><option>css=header.post-head</option></datalist></td><td></td></tr>
</tbody></table>
