<tr><td>click</td><td>name=add-comment<datalist><option>name=add-comment</option><option>xpath=//button[@name='add-comment']</option><option>xpath=//div[@id='comments']/form/div[2]/button</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='*'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Comment:'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Comments'])[1]/preceding::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='John'])[1]/preceding::button[1]</option><option>xpath=//*/text()[normalize-space(.)='New comment']/parent::*</option><option>xpath=//div[2]/button</option><option>css=button[name="add-comment"]</option></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>xpath=//div[@id='comments']/div/div<datalist><option>xpath=//div[@id='comments']/div/div</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Leave your comment'])[1]/following::div[2]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='money'])[2]/following::div[3]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Comment:'])[1]/preceding::div[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='*'])[1]/preceding::div[1]</option><option>xpath=//*/text()[normalize-space(.)='Blog comment is successfully added.']/parent::*</option><option>xpath=//section/div/div[2]/div[2]/div/div</option><option>css=div.result</option></datalist></td><td></td></tr>
</tbody></table>
