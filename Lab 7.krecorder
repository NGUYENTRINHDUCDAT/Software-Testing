<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3" data-tags="">Access Blog</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>https://demo.nopcommerce.com/<datalist><option>https://demo.nopcommerce.com/</option></datalist></td><td></td></tr>
<tr><td>click</td><td>link=Blog<datalist><option>link=Blog</option><option>xpath=//a[contains(text(),'Blog')]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='News'])[2]/following::a[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Search'])[2]/following::a[2]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Recently viewed products'])[1]/preceding::a[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Compare products list'])[1]/preceding::a[2]</option><option>xpath=//*/text()[normalize-space(.)='Blog']/parent::*</option><option>xpath=//a[contains(@href, '/blog')]</option><option>xpath=//nav/div[2]/div/div[3]/a</option></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>xpath=//main[@id='main']/div/section/div/div[2]/div/article/header<datalist><option>xpath=//main[@id='main']/div/section/div/div[2]/div/article/header</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Blog'])[1]/following::header[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='RSS'])[1]/following::header[1]</option><option>xpath=//article/header</option><option>css=header.post-head</option></datalist></td><td></td></tr>
</tbody></table>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3" data-tags="">View blog detail</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>https://demo.nopcommerce.com/<datalist><option>https://demo.nopcommerce.com/</option></datalist></td><td></td></tr>
<tr><td>click</td><td>link=Blog<datalist><option>link=Blog</option><option>xpath=//a[contains(text(),'Blog')]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='News'])[2]/following::a[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Search'])[2]/following::a[2]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Recently viewed products'])[1]/preceding::a[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Compare products list'])[1]/preceding::a[2]</option><option>xpath=//*/text()[normalize-space(.)='Blog']/parent::*</option><option>xpath=//a[contains(@href, '/blog')]</option><option>xpath=//nav/div[2]/div/div[3]/a</option></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>xpath=//main[@id='main']/div/section/div/div[2]/div/article/header<datalist><option>xpath=//main[@id='main']/div/section/div/div[2]/div/article/header</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Blog'])[1]/following::header[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='RSS'])[1]/following::header[1]</option><option>xpath=//article/header</option><option>css=header.post-head</option></datalist></td><td></td></tr>
<tr><td>click</td><td>xpath=//main[@id='main']/div/section/div/div[2]/div/article/header/a/h2<datalist><option>xpath=//main[@id='main']/div/section/div/div[2]/div/article/header/a/h2</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Blog'])[1]/following::h2[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='RSS'])[1]/following::h2[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Tuesday, November 4, 2025'])[1]/preceding::h2[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Tags:'])[1]/preceding::h2[1]</option><option>xpath=//*/text()[normalize-space(.)='How a blog can help your growing e-Commerce business']/parent::*</option><option>xpath=//a/h2</option><option>css=a.post-title > h2</option></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>xpath=//main[@id='main']/div/section/div/div[2]/article/p[2]<datalist><option>xpath=//main[@id='main']/div/section/div/div[2]/article/p[2]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Tuesday, November 4, 2025'])[1]/following::p[2]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='How a blog can help your growing e-Commerce business'])[1]/following::p[2]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='For example:'])[1]/preceding::p[3]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='For example:'])[2]/preceding::p[5]</option><option>xpath=//*/text()[normalize-space(.)='Do you know having a blog for your online store can be very helpful? Many businesses do not understand the importance of having a blog because they don’t have time to post quality content.']/parent::*</option><option>xpath=//p[2]</option></datalist></td><td></td></tr>
</tbody></table>
