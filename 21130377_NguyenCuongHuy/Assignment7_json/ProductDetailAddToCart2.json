{
    "configuration": {
        "device": {
            "orientation": "landscape",
            "deviceName": "Desktop"
        }
    },
    "type": "clickpath",
    "version": "1.0",
    "events": [
        {
            "description": "Loading of \"https://demo.nopcommerce.com/\"",
            "wait": {
                "waitFor": "page_complete"
            },
            "target": {},
            "type": "navigate",
            "url": "https://demo.nopcommerce.com/"
        },
        {
            "description": "click",
            "wait": {
                "waitFor": "page_complete"
            },
            "target": {
                "locators": [
                    {
                        "type": "css",
                        "value": "a:contains(\"Build your own computer\")"
                    }
                ]
            },
            "type": "click",
            "button": 0
        },
        {
            "description": "click",
            "wait": {
                "waitFor": "page_complete"
            },
            "target": {
                "locators": [
                    {
                        "type": "css",
                        "value": "#product_attribute_1"
                    }
                ]
            },
            "type": "click",
            "button": 0
        },
        {
            "description": "click",
            "wait": {
                "waitFor": "page_complete"
            },
            "target": {
                "locators": [
                    {
                        "type": "css",
                        "value": "#product_attribute_2"
                    }
                ]
            },
            "type": "click",
            "button": 0
        },
        {
            "description": "select option",
            "wait": {
                "waitFor": "page_complete"
            },
            "target": {},
            "type": "javascript",
            "javaScript": "\n                    let add = false;\n                    let x = typeof $ !== 'undefined' ? $('#product_attribute_2')[0] : document.querySelector('#product_attribute_2');\n                    for (i = 0; i < x.options.length; i++) {\n                        if (x.options[i].text === \"8GB [+$60.00]\") {\n                            if(add) {\n                                x.options[i].selected = true;\n                            } else {\n                                x.options.selectedIndex = i;\n                            }\n                        }\n                    }"
        },
        {
            "description": "click",
            "wait": {
                "waitFor": "page_complete"
            },
            "target": {
                "locators": [
                    {
                        "type": "css",
                        "value": "#product_attribute_3_7"
                    }
                ]
            },
            "type": "click",
            "button": 0
        },
        {
            "description": "click",
            "wait": {
                "waitFor": "page_complete"
            },
            "target": {
                "locators": [
                    {
                        "type": "css",
                        "value": "#product_attribute_4_9"
                    }
                ]
            },
            "type": "click",
            "button": 0
        },
        {
            "description": "click",
            "wait": {
                "waitFor": "page_complete"
            },
            "target": {
                "locators": [
                    {
                        "type": "css",
                        "value": "#product_attribute_5_11"
                    }
                ]
            },
            "type": "click",
            "button": 0
        }
    ]
}