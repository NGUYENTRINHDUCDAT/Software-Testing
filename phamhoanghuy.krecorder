<tr><td>click</td><td>xpath=//form[@action='/register']<datalist><option>xpath=//form[@action='/register']</option><option>xpath=//main[@id='main']/div/section/div/div[2]/form</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Register'])[2]/following::form[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Gift Cards'])[1]/following::form[1]</option><option>xpath=//section/div/div[2]/form</option><option>css=div.page-body > form</option></datalist></td><td></td></tr>
