<tr><td>type</td><td>id=ConfirmPassword<datalist><option>id=ConfirmPassword</option><option>name=ConfirmPassword</option><option>xpath=//input[@id='ConfirmPassword']</option><option>xpath=//main[@id='main']/div/section/div/div[2]/form/section[4]/div/div[2]/input</option><option>xpath=//section[4]/div/div[2]/input</option><option>css=#ConfirmPassword</option></datalist></td><td>123456</td></tr>
<tr><td>click</td><td>id=register-button<datalist><option>id=register-button</option><option>name=register-button</option><option>xpath=//button[@id='register-button']</option><option>xpath=//main[@id='main']/div/section/div/div[2]/form/section[5]/button</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='The password and confirmation password do not match.'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='*'])[5]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Information'])[1]/preceding::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Sitemap'])[1]/preceding::button[1]</option><option>xpath=//section[5]/button</option><option>css=#register-button</option></datalist></td><td></td></tr>
<tr><td>assertLocation</td><td>https://demo.nopcommerce.com/<datalist><option>https://demo.nopcommerce.com/</option></datalist></td><td></td></tr>
