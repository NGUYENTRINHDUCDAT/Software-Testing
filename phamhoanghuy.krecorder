<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3" data-tags="">Authentication-30-1</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>https://demo.nopcommerce.com/register<datalist><option>https://demo.nopcommerce.com/register</option></datalist></td><td></td></tr>
<tr><td>click</td><td>id=register-button<datalist><option>id=register-button</option><option>name=register-button</option><option>xpath=//button[@id='register-button']</option><option>xpath=//main[@id='main']/div/section/div/div[2]/form/section[5]/button</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='*'])[5]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Confirm password:'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Information'])[1]/preceding::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Sitemap'])[1]/preceding::button[1]</option><option>xpath=//section[5]/button</option><option>css=#register-button</option></datalist></td><td></td></tr>
<tr><td>assertText</td><td>id=FirstName-error<datalist><option>id=FirstName-error</option></datalist></td><td>First name is required.</td></tr>
<tr><td>assertText</td><td>id=LastName-error<datalist><option>id=FirstName-error</option><option>id=LastName-error</option></datalist></td><td>Last name is required.</td></tr>
<tr><td>assertText</td><td>id=Email-error<datalist><option>id=FirstName-error</option><option>id=Email-error</option></datalist></td><td>Email is required.</td></tr>
</tbody></table>
